# Copy this file to .env at the repository root.
# The sidecar loads .env automatically; no repeated export commands are needed.

AGENT_SCHEDULER_DB_PATH=data/openclaw-trace.sqlite3
AGENT_SCHEDULER_TRACE_DIR=data/traces
AGENT_SCHEDULER_RESOURCE_POLL_INTERVAL_MS=50
AGENT_SCHEDULER_RESOURCE_TIMELINE_MAX_POINTS=2000

# tool-resource is the only scheduler predictor backend. Set trace paths to one
# or more OpenClaw trace-v6 JSONL files/directories. Stage-2 artifacts from the
# native tool_resource SDK are also supported. Separate paths with semicolon on
# Windows, colon on Linux/macOS, or commas on any platform.
# AGENT_SCHEDULER_TOOL_RESOURCE_TRACES=data/traces
# AGENT_SCHEDULER_TOOL_RESOURCE_STAGE2_TRACES=data/tool-resource-stage2
# AGENT_SCHEDULER_TOOL_RESOURCE_LATENCY_BUCKETS_MS=100,500,2000,10000
# AGENT_SCHEDULER_TOOL_RESOURCE_REPO=openclaw
# Stores managed-wrapper artifacts and the persistent clause KB snapshot used
# for repo exact/argv-prefix/bin predictions across sidecar restarts.
# AGENT_SCHEDULER_TOOL_RESOURCE_ARTIFACT_DIR=data/tool-resource
# AGENT_SCHEDULER_TOOL_RESOURCE_CONTAINER_EXECUTABLE=docker
# Require managed-wrapper exec claims to start native Stage-2 eBPF clause
# telemetry before the payload command is released. Set to false only for
# hook-only/debug runs where coarse process/cgroup sampling is acceptable.
AGENT_SCHEDULER_TOOL_RESOURCE_STAGE2_REQUIRED=true

# The sidecar LLM proxy forwards OpenClaw's Authorization header by default.
# Do not duplicate your provider API key here if OpenClaw already stores it.
# DeepSeek is the built-in default upstream. Set this only for another
# OpenAI-compatible upstream such as vLLM or a custom gateway.
# AGENT_SCHEDULER_LLM_UPSTREAM_BASE_URL=https://api.deepseek.com

# Optional advanced override only if you intentionally want the sidecar to use
# a different provider key than the one OpenClaw sends in Authorization.
# AGENT_SCHEDULER_LLM_UPSTREAM_API_KEY_OVERRIDE=sk-...

# Model name spoofing (optional — normalisation is already the default).
# The sidecar automatically rewrites upstream /v1/models metadata so OpenClaw
# provider discovery always passes.  Set these only when you need to expose a
# different model name to OpenClaw than the real upstream model.
# AGENT_SCHEDULER_LLM_PROXY_EXPOSE_MODEL=gpt-4o
# AGENT_SCHEDULER_LLM_PROXY_UPSTREAM_MODEL=deepseek-v4-flash

# Optional sidecar auth. Leave unset for local-only development.
# AGENT_SCHEDULER_TOKEN=...
