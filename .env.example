# Copy this file to .env at the repository root.
# The sidecar loads .env automatically; no repeated export commands are needed.

CLAWTUNE_TRACE_DIR=traces
CLAWTUNE_RESOURCE_POLL_INTERVAL_MS=50
CLAWTUNE_RESOURCE_TIMELINE_MAX_POINTS=2000

# tool-resource is the scheduler predictor backend. It learns from OpenClaw
# JSONL traces and native eBPF command artifacts. Separate paths with semicolon
# on Windows, colon on Linux/macOS, or commas on any platform.
# CLAWTUNE_TOOL_RESOURCE_TRACES=traces
# CLAWTUNE_TOOL_RESOURCE_EBPF_TRACES=traces/tool-resource-ebpf
# CLAWTUNE_TOOL_RESOURCE_LATENCY_BUCKETS_MS=100,500,2000,10000
# CLAWTUNE_TOOL_RESOURCE_REPO=openclaw
# KV-TTL cost proxy for the tool-resource prediction output (seconds).
# TTL values are one per latency bucket, including the open-ended tail. When
# omitted, finite buckets use their upper bounds and the tail uses zero.
# Legacy edge-count lists imply a zero tail TTL. Zero means immediate eviction.
# CLAWTUNE_TOOL_RESOURCE_TTL_BY_BUCKET_S=0.1,0.5,2.0,0.0,0.0
# Optional miss penalty (seconds) for KV-TTL proxy cost.
# CLAWTUNE_TOOL_RESOURCE_MISS_PENALTY_S=2.0
# Stores managed-wrapper artifacts and the persistent clause KB snapshot used
# for repo exact/argv-prefix/bin predictions across sidecar restarts.
# CLAWTUNE_TOOL_RESOURCE_ARTIFACT_DIR=traces/tool-resource
# CLAWTUNE_TOOL_RESOURCE_CONTAINER_EXECUTABLE=docker
# eBPF is the primary resource collector and is required by default.
# Startup/managed execution must fail closed rather than silently recording
# coarse fallback data. `python3 scripts/clawtune.py setup` verifies it.
# Set false only for an explicit troubleshooting run whose output is not
# accepted as complete ClawTune telemetry.
CLAWTUNE_TOOL_RESOURCE_EBPF_REQUIRED=true

# The sidecar LLM proxy forwards OpenClaw's Authorization header by default.
# Do not duplicate your provider API key here if OpenClaw already stores it.
# DeepSeek is the built-in default upstream. Set this only for another
# OpenAI-compatible upstream such as vLLM or a custom gateway.
# CLAWTUNE_LLM_UPSTREAM_BASE_URL=https://api.deepseek.com

# Optional advanced override only if you intentionally want the sidecar to use
# a different provider key than the one OpenClaw sends in Authorization.
# CLAWTUNE_LLM_UPSTREAM_API_KEY_OVERRIDE=sk-...

# Model name spoofing (optional — normalisation is already the default).
# The sidecar automatically rewrites upstream /v1/models metadata so OpenClaw
# provider discovery always passes.  Set these only when you need to expose a
# different model name to OpenClaw than the real upstream model.
# CLAWTUNE_LLM_PROXY_EXPOSE_MODEL=gpt-4o
# CLAWTUNE_LLM_PROXY_UPSTREAM_MODEL=deepseek-v4-flash

# Optional sidecar auth. Leave unset for local-only development.
# CLAWTUNE_TOKEN=...
