# ────────────────────────────────────────────────────────────────
# claw-runtime: pre-built Node.js + OpenClaw + sidecar deps.
#
# Built ONCE, mounted into swe-rebench containers at /clawtune/runtime.
# This avoids per-container apt-get/npm/pip install (saves ~3 min/task).
#
# Multi-arch: debian:bookworm-slim supports linux/amd64 and linux/arm64.
# NodeSource setup_22.x also supports arm64.
# On Kunpeng/aarch64, build with:
#   docker build --platform linux/arm64 -t claw-runtime -f swe_rebench/Dockerfile.runtime .
# ────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# ── Node.js 22 (nodesource) ─────────────────────────────────────
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        ca-certificates curl gnupg python3 python3-pip python3-venv \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y -qq --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── OpenClaw CLI ─────────────────────────────────────────────────
RUN npm install -g openclaw@2026.7.1 \
    && openclaw --version

# ── Python deps for sidecar ──────────────────────────────────────
RUN pip3 install --break-system-packages --no-cache-dir \
        fastapi uvicorn pydantic psutil httpx prometheus-client typing-extensions \
    && python3 -c "import fastapi, uvicorn, pydantic, psutil, typing_extensions; print('deps OK')"

# Verify
RUN node --version && openclaw --version && python3 --version
