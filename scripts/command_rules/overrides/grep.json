{
  "grammar": {
    "syntax": {
      "clusters": true,
      "intermixed": true,
      "assignments": false
    },
    "positionals": [
      {
        "role": "operand",
        "min": 1,
        "max": 1,
        "skip_if_options": [
          "-e",
          "--regexp",
          "-f",
          "--file"
        ]
      },
      {
        "role": "operand",
        "min": 0,
        "max": null
      }
    ]
  },
  "options": {
    "-n": {
      "independent": true
    },
    "-e": {
      "independent": true
    },
    "-f": {
      "independent": true
    },
    "-i": {
      "independent": true
    },
    "-v": {
      "independent": true
    },
    "-r": {
      "independent": true
    },
    "-R": {
      "independent": true
    },
    "-l": {
      "independent": true
    },
    "-q": {
      "independent": true
    },
    "-c": {
      "independent": true
    },
    "-w": {
      "independent": true
    },
    "-A": {
      "independent": true
    },
    "-B": {
      "independent": true
    },
    "-C": {
      "independent": true
    },
    "-m": {
      "independent": true
    }
  }
}
