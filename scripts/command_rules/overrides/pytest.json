{
  "grammar": {
    "syntax": {
      "clusters": true,
      "intermixed": true,
      "assignments": false
    },
    "positionals": [
      {
        "role": "operand",
        "min": 0,
        "max": null
      }
    ]
  },
  "options": {
    "-q": {
      "independent": true
    },
    "-s": {
      "independent": true
    },
    "-m": {
      "independent": true
    },
    "-k": {
      "independent": true
    },
    "-x": {
      "independent": true
    },
    "--tb": {
      "independent": true
    },
    "--disable-warnings": {
      "independent": true
    },
    "--collect-only": {
      "independent": true
    },
    "--maxfail": {
      "independent": true
    },
    "--durations": {
      "independent": true
    },
    "-v": {
      "independent": true
    }
  },
  "add_options": [
    {
      "names": [
        "-n",
        "--numprocesses"
      ],
      "canonical": "--numprocesses",
      "min": 1,
      "max": 1,
      "forms": [
        "separate",
        "equals",
        "attached"
      ],
      "optional_value": "attached",
      "dash_values": "attached",
      "repeat": "ordered",
      "independent": true
    }
  ],
  "evidence": [
    "https://pytest-xdist.readthedocs.io/en/stable/distribution.html",
    "https://github.com/pytest-dev/pytest-xdist/blob/master/src/xdist/plugin.py"
  ]
}
