{
  "grammar": {
    "syntax": {
      "clusters": true,
      "intermixed": true,
      "assignments": false
    },
    "positionals": [
      {
        "role": "operand",
        "min": 0,
        "max": null
      }
    ]
  },
  "options": {
    "-n": {
      "independent": true,
      "dash_values": "numeric",
      "leading_numeric_short": true
    },
    "-c": {
      "independent": true,
      "dash_values": "numeric"
    }
  },
  "evidence": [
    "https://www.gnu.org/software/coreutils/manual/html_node/head-invocation.html"
  ]
}
