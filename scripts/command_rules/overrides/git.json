{
  "grammar": {
    "syntax": {
      "clusters": true,
      "intermixed": true,
      "assignments": false
    }
  },
  "options": {
    "-C": {
      "independent": true
    },
    "-c": {
      "independent": true
    },
    "--git-dir": {
      "independent": true
    },
    "--work-tree": {
      "independent": true
    }
  },
  "subcommand_options": {
    "config": {
      "update": {
        "--local": {
          "min": 0,
          "max": 0
        }
      },
      "grammar": {
        "positionals": [
          {
            "min": 0,
            "max": null,
            "role": "operand"
          }
        ]
      }
    },
    "branch": {
      "update": {
        "--delete": {
          "min": 0,
          "max": 0
        },
        "-D": {
          "min": 0,
          "max": 0
        }
      },
      "grammar": {
        "positionals": [
          {
            "min": 0,
            "max": null,
            "role": "operand"
          }
        ]
      }
    },
    "rebase": {
      "update": {
        "--strategy": {
          "min": 1,
          "max": 1,
          "optional_value": "attached"
        }
      }
    },
    "pull": {
      "update": {
        "--strategy": {
          "min": 1,
          "max": 1,
          "optional_value": "attached"
        }
      }
    },
    "merge": {
      "update": {
        "--strategy": {
          "min": 1,
          "max": 1,
          "optional_value": "attached"
        }
      }
    },
    "diff": {
      "add": [
        {
          "names": [
            "--check"
          ],
          "canonical": "--check",
          "min": 0,
          "max": 0,
          "forms": [
            "separate"
          ],
          "optional_value": "attached",
          "dash_values": "attached",
          "repeat": "ordered",
          "independent": true,
          "persistent": false
        }
      ]
    },
    "apply": {
      "grammar": {
        "positionals": [
          {
            "min": 0,
            "max": null,
            "role": "operand"
          }
        ]
      }
    },
    "show": {
      "grammar": {
        "positionals": [
          {
            "min": 0,
            "max": null,
            "role": "operand"
          }
        ]
      }
    },
    "log": {
      "grammar": {
        "positionals": [
          {
            "min": 0,
            "max": null,
            "role": "operand"
          }
        ]
      },
      "add": [
        {
          "names": [
            "--all"
          ],
          "canonical": "--all",
          "min": 0,
          "max": 0,
          "forms": [
            "separate"
          ],
          "optional_value": "attached",
          "dash_values": "attached",
          "repeat": "ordered",
          "independent": true,
          "persistent": false
        }
      ]
    }
  },
  "evidence": [
    "https://git-scm.com/docs/git-config",
    "https://git-scm.com/docs/git-merge",
    "https://git-scm.com/docs/git-branch",
    "https://git-scm.com/docs/git-diff",
    "https://git-scm.com/docs/git-apply",
    "https://git-scm.com/docs/git-show",
    "https://git-scm.com/docs/git-log"
  ]
}
