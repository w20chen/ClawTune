{
  "grammar": {
    "syntax": {
      "clusters": true,
      "intermixed": true,
      "assignments": false
    },
    "positionals": [
      {
        "role": "script_entry",
        "min": 0,
        "max": 1
      }
    ],
    "literals": {
      "-": {
        "mode": "stdin",
        "action": "opaque"
      }
    }
  },
  "options": {
    "-u": {
      "independent": true
    },
    "-B": {
      "independent": true
    },
    "-s": {
      "independent": true
    },
    "-S": {
      "independent": true
    },
    "-E": {
      "independent": true
    },
    "-I": {
      "independent": true
    },
    "-W": {
      "independent": true,
      "dash_values": "any"
    },
    "-X": {
      "independent": true,
      "dash_values": "any"
    },
    "-b": {
      "independent": true
    },
    "-v": {
      "independent": true
    },
    "-O": {
      "independent": true
    },
    "--help": {
      "independent": true
    },
    "--version": {
      "independent": true
    },
    "-m": {
      "transition": {
        "mode": "module",
        "action": "module"
      },
      "dash_values": "any"
    },
    "-c": {
      "transition": {
        "mode": "inline",
        "action": "opaque"
      },
      "dash_values": "any"
    }
  },
  "remove_options": [
    "-g"
  ],
  "add_options": [
    {
      "names": [
        "-q"
      ],
      "canonical": "-q",
      "min": 0,
      "max": 0,
      "forms": [
        "separate",
        "attached",
        "equals"
      ],
      "optional_value": "attached",
      "dash_values": "attached",
      "repeat": "ordered",
      "independent": true
    }
  ]
}
