{
  "grammar": {
    "syntax": {
      "clusters": true,
      "intermixed": true,
      "assignments": false
    },
    "positionals": [
      {
        "role": "operand",
        "min": 0,
        "max": null
      }
    ]
  },
  "options": {},
  "names": [
    "pip",
    "pip3"
  ],
  "add_options": [
    {
      "names": [
        "--no-cache-dir"
      ],
      "canonical": "--no-cache-dir",
      "min": 0,
      "max": 0,
      "forms": [
        "separate",
        "equals",
        "attached"
      ],
      "optional_value": "attached",
      "dash_values": "attached",
      "repeat": "ordered",
      "independent": true,
      "persistent": true
    },
    {
      "names": [
        "--disable-pip-version-check"
      ],
      "canonical": "--disable-pip-version-check",
      "min": 0,
      "max": 0,
      "forms": [
        "separate",
        "equals",
        "attached"
      ],
      "optional_value": "attached",
      "dash_values": "attached",
      "repeat": "ordered",
      "independent": true,
      "persistent": true
    }
  ],
  "subcommand_options": {
    "install": {
      "add": [
        {
          "names": [
            "--no-deps"
          ],
          "canonical": "--no-deps",
          "min": 0,
          "max": 0,
          "forms": [
            "separate",
            "equals",
            "attached"
          ],
          "optional_value": "attached",
          "dash_values": "attached",
          "repeat": "ordered",
          "independent": true,
          "persistent": false
        },
        {
          "names": [
            "--break-system-packages"
          ],
          "canonical": "--break-system-packages",
          "min": 0,
          "max": 0,
          "forms": [
            "separate",
            "equals",
            "attached"
          ],
          "optional_value": "attached",
          "dash_values": "attached",
          "repeat": "ordered",
          "independent": true,
          "persistent": false
        },
        {
          "names": [
            "-e",
            "--editable"
          ],
          "canonical": "--editable",
          "min": 1,
          "max": 1,
          "forms": [
            "separate",
            "equals",
            "attached"
          ],
          "optional_value": "attached",
          "dash_values": "attached",
          "repeat": "ordered",
          "independent": true
        }
      ],
      "update": {
        "-r": {
          "independent": true
        }
      }
    }
  }
}
