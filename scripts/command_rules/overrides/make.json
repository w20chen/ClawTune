{
  "grammar": {
    "syntax": {
      "clusters": true,
      "intermixed": true,
      "assignments": false
    },
    "positionals": [
      {
        "role": "operand",
        "min": 0,
        "max": null
      }
    ]
  },
  "options": {
    "-j": {
      "min": 0,
      "max": 1,
      "optional_value": "numeric",
      "dash_values": "numeric",
      "independent": true
    },
    "-C": {
      "independent": true
    },
    "-f": {
      "independent": true
    },
    "-B": {
      "min": 0,
      "max": 0
    },
    "-e": {
      "min": 0,
      "max": 0
    }
  }
}
