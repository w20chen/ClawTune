{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/kb-state.schema.json",
  "type": "object",
  "required": ["schema", "owner", "seed_sha256", "generation", "snapshots"],
  "properties": {
    "schema": {"enum": ["clawtune.kb-state.v1", "clawtune.kb-state.v2"]},
    "owner": {"type": "string", "minLength": 1},
    "seed_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation": {"type": "integer", "minimum": 0},
    "snapshots": {}
  },
  "if": {"properties": {"schema": {"const": "clawtune.kb-state.v1"}}},
  "then": {"properties": {"snapshots": {"$ref": "kb-seed.schema.json#/properties/snapshots"}}},
  "else": {
    "properties": {
      "snapshots": {
        "type": "array",
        "uniqueItems": true,
        "items": {"enum": ["clause-resource-kb.json", "runtime-tool-resource-kb.json", "clause-lattice-time-kb.json"]},
        "allOf": [
          {"contains": {"const": "clause-resource-kb.json"}},
          {"contains": {"const": "runtime-tool-resource-kb.json"}},
          {"contains": {"const": "clause-lattice-time-kb.json"}}
        ]
      }
    }
  },
  "additionalProperties": false
}
