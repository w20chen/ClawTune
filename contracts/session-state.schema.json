{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/session-state.schema.json",
  "description": "Both session publications carry a complete state snapshot. Compare revision across both types, scoped by publisher_id and owner; never compare with the legacy global sequence. remaining_ms estimates batch logical completion, not guaranteed model arrival.",
  "type": "object", "additionalProperties": false,
  "required": ["revision", "state_revision", "phase", "reason", "batch_id", "session_key", "parent_session_key", "run_status", "model_call_id", "remaining_ms"],
  "properties": {
    "revision": {"type": "integer", "minimum": 1},
    "state_revision": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["UNKNOWN", "IDLE", "CONTROL", "LLM", "TOOLS", "HANDOFF", "WAIT_EVENT"]},
    "reason": {"type": "string", "minLength": 1},
    "batch_id": {"type": ["string", "null"]},
    "session_key": {"type": ["string", "null"]},
    "parent_session_key": {"type": ["string", "null"]},
    "run_status": {"enum": ["active", "finishing", "ended", "error", "cancelled", "yielded", "closed"]},
    "model_call_id": {"type": ["string", "null"]},
    "remaining_ms": {"type": ["number", "null"], "minimum": 0}
  }
}
