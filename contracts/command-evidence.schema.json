{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/command-evidence.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "source",
        "help",
        "config"
      ]
    },
    "entry": {
      "type": "string",
      "maxLength": 65536
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "content_hash": {
      "type": "string",
      "maxLength": 65536
    },
    "source": {
      "type": "string",
      "maxLength": 65536
    },
    "acquired_at": {
      "type": "number"
    },
    "available": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "entry",
    "text",
    "content_hash",
    "source",
    "acquired_at",
    "available"
  ],
  "additionalProperties": false
}
