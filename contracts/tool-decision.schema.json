{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/tool-decision.schema.json",
  "type": "object",
  "required": [
    "decision_id",
    "action",
    "reason_code",
    "reason",
    "policy_name",
    "policy_version",
    "lease_id",
    "prediction"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "allow",
        "block"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "policy_name": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "prediction": {
      "$ref": "tool-prediction.schema.json"
    },
    "placement": {},
    "profiling": {},
    "prediction_signal_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Signal ID of the single prediction.created publication sharing this decision prediction."
    }
  },
  "additionalProperties": false
}
