{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/scheduler/tool-decision.schema.json",
  "type": "object",
  "$defs": {
    "clauseLatencyBucketPrediction": {
      "type": "object",
      "properties": {
        "bucket_id": {"type": "integer", "minimum": 0},
        "probability_by_bucket": {
          "type": "array",
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "scope": {"type": "string"},
        "key_kind": {"type": "string"},
        "evidence_count": {"type": "integer", "minimum": 0},
        "fallback_path": {"type": "array", "items": {"type": "string"}}
      },
      "required": [
        "bucket_id",
        "probability_by_bucket",
        "scope",
        "key_kind",
        "evidence_count",
        "fallback_path"
      ],
      "additionalProperties": false
    },
    "clauseLatencyBucketOutcome": {
      "type": "object",
      "description": "Latency-bucket result for one static clause that requires a runtime exec image. Shell builtins that execute inside the shell are intentionally omitted; clause_index maps each result back to the unfiltered clause_bins sequence.",
      "properties": {
        "clause_index": {"type": "integer", "minimum": 0},
        "bin": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "prediction": {
          "anyOf": [
            {"$ref": "#/$defs/clauseLatencyBucketPrediction"},
            {"type": "null"}
          ]
        },
        "unavailable_reason": {"type": ["string", "null"]}
      },
      "required": [
        "clause_index",
        "bin",
        "argv",
        "prediction",
        "unavailable_reason"
      ],
      "oneOf": [
        {
          "properties": {
            "prediction": {"$ref": "#/$defs/clauseLatencyBucketPrediction"},
            "unavailable_reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "prediction": {"type": "null"},
            "unavailable_reason": {"type": "string", "minLength": 1}
          }
        }
      ],
      "additionalProperties": false
    },
    "latticeTimePrediction": {
      "type": "object",
      "description": "One clause-level point prediction produced from the shared, unlayered lattice KB.",
      "properties": {
        "algorithm": {"enum": ["shrinkage", "loso", "max_cardinality"]},
        "prediction_ms": {"type": ["number", "null"], "minimum": 0},
        "selected_features": {"type": "array", "items": {"type": "string"}},
        "evidence_count": {"type": "integer", "minimum": 0},
        "selected_risk": {"type": ["number", "null"], "minimum": 0},
        "exact_match": {"type": ["boolean", "null"]},
        "fallback": {"type": ["string", "null"]},
        "unavailable_reason": {"type": ["string", "null"]}
      },
      "required": [
        "algorithm",
        "prediction_ms",
        "selected_features",
        "evidence_count",
        "selected_risk",
        "exact_match",
        "fallback",
        "unavailable_reason"
      ],
      "oneOf": [
        {
          "properties": {
            "prediction_ms": {"type": "number", "minimum": 0},
            "exact_match": {"type": "boolean"},
            "unavailable_reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "prediction_ms": {"type": "null"},
            "exact_match": {"type": "null"},
            "unavailable_reason": {"type": "string", "minLength": 1}
          }
        }
      ],
      "additionalProperties": false
    },
    "clauseLatticeTimePredictions": {
      "type": "object",
      "description": "The three point estimates for one exec-producing static clause. Compound command estimates are intentionally not composed.",
      "properties": {
        "clause_index": {"type": "integer", "minimum": 0},
        "bin": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "predictions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/latticeTimePrediction"},
                {"properties": {"algorithm": {"const": "shrinkage"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/latticeTimePrediction"},
                {"properties": {"algorithm": {"const": "loso"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/latticeTimePrediction"},
                {"properties": {"algorithm": {"const": "max_cardinality"}}}
              ]
            }
          ],
          "items": false
        }
      },
      "required": ["clause_index", "bin", "argv", "predictions"],
      "additionalProperties": false
    },
    "kvTTLCost": {
      "type": "object",
      "description": "Prediction-time KV-TTL cost proxy against the p90 bucket distribution estimate.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reference_runtime_s": {"type": "number", "minimum": 0},
            "initial_bucket_index": {"type": "integer", "minimum": 0},
            "final_bucket_index": {"type": "integer", "minimum": 0},
            "num_bucket_jumps": {"type": "integer", "minimum": 0},
            "bucket_exhausted": {"type": "boolean"},
            "ttl_s": {"type": "number", "minimum": 0},
            "kv_retention_time_s": {"type": "number", "minimum": 0},
            "kv_cache_miss": {"type": "boolean"},
            "proxy_cost_s": {"type": ["number", "null"], "minimum": 0},
            "buckets_s": {"type": "array", "items": {"type": "number", "minimum": 0}},
            "ttl_by_bucket_s": {"type": "array", "items": {"type": "number", "minimum": 0}},
            "miss_penalty_s": {"type": ["number", "null"], "minimum": 0}
          },
          "required": [
            "reference_runtime_s",
            "initial_bucket_index",
            "final_bucket_index",
            "num_bucket_jumps",
            "bucket_exhausted",
            "ttl_s",
            "kv_retention_time_s",
            "kv_cache_miss",
            "proxy_cost_s",
            "buckets_s",
            "ttl_by_bucket_s",
            "miss_penalty_s"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unavailable_reason": {"type": "string", "minLength": 1},
            "initial_bucket_index": {"type": "integer", "minimum": 0}
          },
          "required": ["unavailable_reason"],
          "additionalProperties": false
        }
      ]
    },
    "compositionUnit": {
      "type": "object",
      "description": "One unit of a derived compound-latency composition. Serial units (; && ||) sum; pipeline units (|) contribute their slowest stage after trailing result-viewing consumers are dropped.",
      "required": ["kind", "bins", "time_ms", "dropped_viewer_bins"],
      "properties": {
        "kind": {"enum": ["single", "pipeline"]},
        "bins": {"type": "array", "items": {"type": "string"}},
        "time_ms": {"type": "number", "minimum": 0},
        "dropped_viewer_bins": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "required": ["decision_id", "action", "reason_code", "reason", "policy_name", "policy_version", "lease_id", "prediction", "placement_advice"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["allow", "block"]},
    "reason_code": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "policy_name": {"type": "string"},
    "policy_version": {"type": "string"},
    "lease_id": {"type": ["string", "null"]},
    "prediction": {
      "type": "object",
      "required": ["duration_p50_ms", "duration_p90_ms", "resource_class", "confidence"],
      "properties": {
        "duration_p50_ms": {"type": ["integer", "null"], "minimum": 0},
        "duration_p90_ms": {"type": ["integer", "null"], "minimum": 0},
        "resource_class": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "tool_resource": {
          "type": ["object", "null"],
          "description": "Native tool_resource CommandLatencyBucketPrediction payload.",
          "properties": {
            "repo": {"type": "string"},
            "command": {"type": "string"},
            "parse_failed": {"type": "boolean"},
            "clause_bins": {"type": "array", "items": {"type": "string"}},
            "clause_predictions": {
              "type": "array",
              "items": {"$ref": "#/$defs/clauseLatencyBucketOutcome"}
            },
            "prediction": {
              "anyOf": [
                {"$ref": "#/$defs/clauseLatencyBucketPrediction"},
                {"type": "null"}
              ]
            },
            "unavailable_reason": {"type": ["string", "null"]},
            "continuous_predictions": {
              "type": "object",
              "description": "Best-effort non-MLP RuntimeToolResourceKB TargetPrediction payloads keyed by target name.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "target": {"type": "string"},
                  "conditional_p90": {"type": ["number", "null"]},
                  "scope": {"type": ["string", "null"]},
                  "key_kind": {"type": ["string", "null"]},
                  "evidence_count": {"type": "integer", "minimum": 0},
                  "fallback_path": {"type": "array", "items": {"type": "string"}},
                  "note": {"type": ["string", "null"]}
                },
                "required": [
                  "target",
                  "conditional_p90",
                  "scope",
                  "key_kind",
                  "evidence_count",
                  "fallback_path",
                  "note"
                ],
                "additionalProperties": false
              }
            },
            "lattice_time_predictions": {
              "type": "array",
              "description": "Clause-level shrinkage, LOSO, and max-cardinality point predictions sharing one independent lattice KB.",
              "items": {"$ref": "#/$defs/clauseLatticeTimePredictions"}
            },
            "prediction_algorithms": {
              "type": "object",
              "description": "Prediction algorithms evaluated for this request. The sidecar records enabled non-MLP tool_resource predictors and explicitly records excluded algorithms such as MLP.",
              "properties": {
                "enabled": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string"},
                      "family": {"type": "string"},
                      "source": {"type": "string"},
                      "targets": {"type": "array", "items": {"type": "string"}},
                      "outputs": {"type": "array", "items": {"type": "string"}}
                    },
                    "required": ["name", "family", "source", "targets", "outputs"],
                    "additionalProperties": false
                  }
                },
                "excluded": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string"},
                      "source": {"type": "string"},
                      "reason": {"type": "string"}
                    },
                    "required": ["name", "source", "reason"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["enabled", "excluded"],
              "additionalProperties": false
            },
            "kv_ttl_cost": {
              "anyOf": [
                {"type": "null"},
                {"$ref": "#/$defs/kvTTLCost"}
              ]
            },
            "composed": {
              "type": "boolean",
              "description": "True when the command-level prediction is a derived total composed from per-clause median latencies."
            },
            "composed_total_ms": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "Composed total latency in milliseconds when composed is true."
            },
            "composition": {
              "type": "array",
              "description": "Per-unit breakdown of the derived composition when composed is true.",
              "items": {"$ref": "#/$defs/compositionUnit"}
            }
          },
          "required": [
            "repo",
            "command",
            "parse_failed",
            "clause_bins",
            "clause_predictions",
            "prediction",
            "unavailable_reason",
            "continuous_predictions",
            "prediction_algorithms"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "placement_advice": {
      "type": "object",
      "required": ["cpu_set", "numa_node", "llc_cluster", "advisory"],
      "properties": {
        "cpu_set": {"type": ["string", "null"]},
        "numa_node": {"type": ["integer", "null"], "minimum": 0},
        "llc_cluster": {"type": ["string", "null"]},
        "advisory": {"const": true}
      },
      "additionalProperties": false
    },
    "placement": {},
    "profiling": {}
  },
  "additionalProperties": false
}
