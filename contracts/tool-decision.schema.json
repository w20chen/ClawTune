{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/scheduler/tool-decision.schema.json",
  "type": "object",
  "required": ["decision_id", "action", "reason_code", "reason", "policy_name", "policy_version", "lease_id", "prediction", "placement_advice"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["allow", "block"]},
    "reason_code": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "policy_name": {"type": "string"},
    "policy_version": {"type": "string"},
    "lease_id": {"type": ["string", "null"]},
    "prediction": {
      "type": "object",
      "required": ["duration_p50_ms", "duration_p90_ms", "resource_class", "confidence"],
      "properties": {
        "duration_p50_ms": {"type": ["integer", "null"], "minimum": 0},
        "duration_p90_ms": {"type": ["integer", "null"], "minimum": 0},
        "resource_class": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "tool_resource": {
          "type": ["object", "null"],
          "description": "Native tool_resource CommandLatencyBucketPrediction payload.",
          "properties": {
            "repo": {"type": "string"},
            "command": {"type": "string"},
            "parse_failed": {"type": "boolean"},
            "clause_bins": {"type": "array", "items": {"type": "string"}},
            "prediction": {
              "type": ["object", "null"],
              "properties": {
                "bucket_id": {"type": "integer", "minimum": 0},
                "probability_by_bucket": {
                  "type": "array",
                  "items": {"type": "number", "minimum": 0, "maximum": 1}
                },
                "scope": {"type": "string"},
                "key_kind": {"type": "string"},
                "evidence_count": {"type": "integer", "minimum": 0},
                "fallback_path": {"type": "array", "items": {"type": "string"}}
              },
              "required": [
                "bucket_id",
                "probability_by_bucket",
                "scope",
                "key_kind",
                "evidence_count",
                "fallback_path"
              ],
              "additionalProperties": false
            },
            "unavailable_reason": {"type": ["string", "null"]},
            "continuous_predictions": {
              "type": "object",
              "description": "Best-effort non-MLP RuntimeToolResourceKB TargetPrediction payloads keyed by target name.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "target": {"type": "string"},
                  "conditional_p90": {"type": ["number", "null"]},
                  "scope": {"type": ["string", "null"]},
                  "key_kind": {"type": ["string", "null"]},
                  "evidence_count": {"type": "integer", "minimum": 0},
                  "fallback_path": {"type": "array", "items": {"type": "string"}},
                  "note": {"type": ["string", "null"]}
                },
                "required": [
                  "target",
                  "conditional_p90",
                  "scope",
                  "key_kind",
                  "evidence_count",
                  "fallback_path",
                  "note"
                ],
                "additionalProperties": false
              }
            },
            "prediction_algorithms": {
              "type": "object",
              "description": "Prediction algorithms evaluated for this request. The sidecar records enabled non-MLP tool_resource predictors and explicitly records excluded algorithms such as MLP.",
              "properties": {
                "enabled": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string"},
                      "family": {"type": "string"},
                      "source": {"type": "string"},
                      "targets": {"type": "array", "items": {"type": "string"}},
                      "outputs": {"type": "array", "items": {"type": "string"}}
                    },
                    "required": ["name", "family", "source", "targets", "outputs"],
                    "additionalProperties": false
                  }
                },
                "excluded": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string"},
                      "source": {"type": "string"},
                      "reason": {"type": "string"}
                    },
                    "required": ["name", "source", "reason"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["enabled", "excluded"],
              "additionalProperties": false
            }
          },
          "required": [
            "repo",
            "command",
            "parse_failed",
            "clause_bins",
            "prediction",
            "unavailable_reason",
            "continuous_predictions",
            "prediction_algorithms"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "placement_advice": {
      "type": "object",
      "required": ["cpu_set", "numa_node", "llc_cluster", "advisory"],
      "properties": {
        "cpu_set": {"type": ["string", "null"]},
        "numa_node": {"type": ["integer", "null"], "minimum": 0},
        "llc_cluster": {"type": ["string", "null"]},
        "advisory": {"const": true}
      },
      "additionalProperties": false
    },
    "placement": {},
    "profiling": {}
  },
  "additionalProperties": false
}
