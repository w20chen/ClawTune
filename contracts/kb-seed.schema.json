{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/kb-seed.schema.json",
  "type": "object",
  "required": ["schema", "provenance", "snapshots"],
  "properties": {
    "schema": {"const": "clawtune.seed.v1"},
    "provenance": {"type": "object"},
    "snapshots": {
      "type": "object",
      "required": ["clause-resource-kb.json", "runtime-tool-resource-kb.json", "clause-lattice-time-kb.json"],
      "properties": {
        "clause-resource-kb.json": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "runtime-tool-resource-kb.json": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "clause-lattice-time-kb.json": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
