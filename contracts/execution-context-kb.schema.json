{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/execution-context-kb.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "samples"],
  "properties": {
    "schema": {"const": "clawtune.execution-context-kb.v1"},
    "samples": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "task", "duration_ms", "failure", "keys"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "duration_ms": {"type": "number", "minimum": 0},
          "failure": {"enum": [null, "missing_executable", "missing_module", "startup_import", "collection_import"]},
          "keys": {
            "type": "object", "additionalProperties": false,
            "required": ["evidence", "failure"],
            "properties": {
              "evidence": {"type": ["string", "null"]},
              "failure": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
