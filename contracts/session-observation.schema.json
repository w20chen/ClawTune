{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/session-observation.schema.json",
  "description": "Complete plugin control snapshot. Revision increases within one runtime/session. Repeated identical revisions renew liveness, not ETA. Contains no tool arguments or output text.",
  "type": "object",
  "required": ["revision", "observer_id", "observer_started_at", "session_key", "parent_session_key", "active_child_session_keys", "wait", "run_status", "model_call_id", "batch"],
  "additionalProperties": false,
  "properties": {
    "revision": {"type": "integer", "minimum": 1},
    "observer_id": {"type": "string", "minLength": 1},
    "observer_started_at": {"type": "number", "minimum": 0},
    "session_key": {"type": ["string", "null"]},
    "parent_session_key": {"type": ["string", "null"]},
    "active_child_session_keys": {
      "type": "array", "maxItems": 1024, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Direct child sessions whose latest observed subagent run has not ended."
    },
    "wait": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["reason", "mode", "session_keys"],
          "properties": {
            "reason": {"const": "subagent_completion"},
            "mode": {"enum": ["any", "unknown"]},
            "session_keys": {
              "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "run_status": {"enum": ["active", "finishing", "ended", "error", "cancelled", "yielded", "closed"]},
    "model_call_id": {"type": ["string", "null"]},
    "batch": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["batch_id", "execution_mode", "mode_source", "tools"],
          "properties": {
            "batch_id": {"type": "string", "minLength": 1},
            "execution_mode": {"enum": ["parallel", "sequential", "unknown"]},
            "mode_source": {"type": "string", "minLength": 1},
            "tools": {
              "type": "array", "minItems": 1, "maxItems": 1024,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["tool_call_id", "started", "settled", "foreground", "predicted_duration_ms", "prediction_source"],
                "properties": {
                  "tool_call_id": {"type": "string", "minLength": 1},
                  "started": {"type": "boolean"},
                  "settled": {"type": "boolean"},
                  "foreground": {"type": "boolean", "description": "Process progress is applicable to logical completion; false when background policy is unknown."},
                  "predicted_duration_ms": {"type": ["number", "null"], "minimum": 0,
                    "description": "duration_ms p50 selected by the LatticeKB then ToolKB fallback chain."},
                  "prediction_source": {"type": ["string", "null"], "enum": ["lattice", "tool", null]}
                },
                "allOf": [
                  {
                    "if": {"properties": {"settled": {"const": true}}},
                    "then": {"properties": {"started": {"const": true}}}
                  },
                  {
                    "if": {"properties": {"predicted_duration_ms": {"type": "number"}}},
                    "then": {"properties": {"prediction_source": {"enum": ["lattice", "tool"]}}},
                    "else": {"properties": {"prediction_source": {"type": "null"}}}
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
