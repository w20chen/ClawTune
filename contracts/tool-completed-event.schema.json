{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/tool-completed-event.schema.json",
  "unevaluatedProperties": false,
  "allOf": [
    {"$ref": "common.schema.json"},
    {
      "type": "object",
      "required": ["tool_call_id", "decision_id", "lease_id", "execution_id", "tool_name", "duration_ms", "succeeded", "error_type", "error_digest", "result_size_bytes"],
      "properties": {
        "tool_call_id": {"type": ["string", "null"]},
        "decision_id": {"type": ["string", "null"]},
        "lease_id": {"type": ["string", "null"]},
        "execution_id": {"type": ["string", "null"]},
        "tool_name": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 0},
        "plugin_window_ns": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
        "tool_body_ns": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
        "decision_duration_ns": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
        "completion_duration_ns": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
        "sidecar_overhead_ns": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
        "succeeded": {"type": "boolean"},
        "error_type": {"type": ["string", "null"]},
        "error_digest": {"type": ["string", "null"]},
        "result_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "raw_result": {},
        "raw_event": {},
        "resource_scope": {
          "type": ["object", "null"],
          "properties": {
            "kind": {"enum": ["pid", "cgroup-v2"], "default": "pid"},
            "execution_id": {"type": ["string", "null"]},
            "pid": {"type": ["integer", "null"], "minimum": 0},
            "root_pid": {"type": ["integer", "null"], "minimum": 0},
            "process_start_time": {"type": ["number", "null"], "minimum": 0},
            "root_starttime_ticks": {"type": ["number", "null"], "minimum": 0},
            "cgroup_path": {"type": ["string", "null"]},
            "pid_namespace_inode": {"type": ["integer", "null"], "minimum": 0},
            "container_id": {"type": ["string", "null"]},
            "include_children": {"type": "boolean", "default": true},
            "source": {"type": ["string", "null"]},
            "attribution_source": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
