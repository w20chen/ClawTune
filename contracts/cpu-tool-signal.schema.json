{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawtune/cpu-tool-signal.schema.json",
  "description": "Advisory CPU tool lifecycle events posted to the configured GPU signal endpoint. Delivery is best effort, without retries. Remaining time is measured at t, not at receipt.",
  "type": "object",
  "required": ["schema_version", "event", "request_id", "engine_request_id", "agent_request_id", "session_id", "t", "engine_id", "role", "engine_step"],
  "properties": {
    "schema_version": {"const": 1},
    "event": {"enum": ["tool_start", "tool_finishing_soon", "tool_prediction_updated"]},
    "request_id": {"type": "string", "minLength": 1, "description": "Tool call ID, falling back to the execution ID when unavailable."},
    "engine_request_id": {"type": "string", "minLength": 1, "description": "Unique ClawTune execution ID."},
    "agent_request_id": {"type": "string", "minLength": 1, "description": "Same correlation identifier as request_id."},
    "session_id": {"type": ["string", "null"]},
    "t": {"type": "number", "minimum": 0, "description": "Event observation time in Unix seconds."},
    "engine_id": {"const": "cpu-tool"},
    "role": {"const": "A"},
    "engine_step": {"const": 0}
  },
  "oneOf": [
    {
      "properties": {
        "event": {"const": "tool_start"},
        "predicted_duration_ms": {"type": "number", "exclusiveMinimum": 0, "description": "Historical p90 duration passed by the plugin; not a remaining-time countdown."},
        "progress_adapter": {"type": "string", "minLength": 1}
      },
      "required": ["predicted_duration_ms", "progress_adapter"]
    },
    {
      "properties": {
        "event": {"const": "tool_finishing_soon"},
        "remaining_duration_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000},
        "remaining_source": {"type": "string", "minLength": 1},
        "remaining_kind": {"enum": ["exact", "estimated"], "description": "Current built-in CLI adapters emit estimated only."}
      },
      "required": ["remaining_duration_ms", "remaining_source", "remaining_kind"]
    },
    {
      "description": "At most one update per execution, from a fresh progress observation after elapsed time exceeds the original LatticeKB prediction by more than 1000 ms. The total is elapsed_duration_ms + remaining_duration_ms; it is an estimate, not a new percentile or a KB training label.",
      "properties": {
        "event": {"const": "tool_prediction_updated"},
        "baseline_source": {"const": "lattice"},
        "baseline_statistic": {"const": "p50"},
        "baseline_prediction_ms": {"type": "number", "minimum": 0},
        "overrun_threshold_ms": {"const": 1000},
        "elapsed_duration_ms": {"type": "number", "exclusiveMinimum": 1000},
        "remaining_duration_ms": {"type": "number", "exclusiveMinimum": 0},
        "predicted_total_duration_ms": {"type": "number", "exclusiveMinimum": 1000},
        "remaining_source": {"type": "string", "minLength": 1},
        "remaining_kind": {"enum": ["exact", "estimated"]}
      },
      "required": ["baseline_source", "baseline_statistic", "baseline_prediction_ms", "overrun_threshold_ms", "elapsed_duration_ms", "remaining_duration_ms", "predicted_total_duration_ms", "remaining_source", "remaining_kind"]
    }
  ],
  "unevaluatedProperties": false
}
